$var wire 1 ] next_value_ce1 $end
$var wire 1 ^ i_mock0 $end
$var wire 1 _ i_mock1 $end
$var wire 1 ` async_clk $end
$var wire 1 a sys_clk $end
$var wire 4 b bus_sel $end
$enddefinitions $end
$dumpvars
$end
