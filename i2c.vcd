$scope module I2CMaster $end
$var wire 1 ! scl $end
$var wire 1 " sda $end
$var wire 30 # bus_adr $end
$var wire 32 $ bus_dat_w $end
$var wire 32 % bus_dat_r $end
$var wire 1 & bus_cyc $end
$var wire 1 ' bus_stb $end
$var wire 1 ( bus_ack $end
$var wire 1 ) bus_we $end
$var wire 1 * i2c_scl_o $end
$var wire 1 + i2c_sda_o $end
$var wire 1 , i2c_sda_i $end
$var wire 20 - i2c_load $end
$var wire 1 . i2c_clk2x $end
$var wire 20 / i2c_cnt $end
$var wire 1 0 i2c_cg_ce $end
