From c721ad3dd41ec73bd54f7c22dc315582391255b4 Mon Sep 17 00:00:00 2001
From: Florent Kermarrec <florent@enjoy-digital.fr>
Date: Mon, 27 Apr 2026 11:48:02 +0000
Subject: [PATCH 22/22] soc/integration: derive SATA sys_clk requirement from
 bus.data_width

add_sata's clock check was `sys_clk_freq >= sata_clk_freq / 2`,
with a FIXME calling out that the /2 hardcoded a 16-bit
data-width assumption. The correct check is throughput-based:

  line_rate         = sata_clk_freq * 16   (independent of phy.data_width;
                                            sata_clk_freqs[gen] is the 16-bit
                                            phy clock so multiplying by 16
                                            yields the line rate in bits/s)
  required_sys_clk  = line_rate / self.bus.data_width

For the historical default of self.bus.data_width == 32 this
simplifies to exactly sata_clk_freq / 2, so every existing build
gets the same answer (gen1: 37.5 MHz, gen2: 75 MHz, gen3: 150 MHz).
A wider SoC bus relaxes the requirement (64-bit halves it again,
gen3 needing only 75 MHz of sys_clk), and a narrower bus tightens
it (16-bit needs the full sata_clk_freq).

Verified across 12 (gen, bus_data_width, sys_clk) boundary
combinations that the new formula gives the expected pass/fail
result. test_wishbone.py still 23/23. digilent_arty (no SATA in
this target, but the SoC integration path is unchanged) builds
byte-identical at 778 KiB.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 litex/soc/integration/soc.py | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/litex/soc/integration/soc.py b/litex/soc/integration/soc.py
index 1f78b5eb7..321cbc3a8 100644
--- a/litex/soc/integration/soc.py
+++ b/litex/soc/integration/soc.py
@@ -2503,16 +2503,20 @@ class LiteXSoC(SoC):
             self.logger.error("SATA {} {}: must be \"read\", \"write\" or \"read+write\".".format(
                 colorer("mode"), colorer(mode, color="red")))
             raise SoCError()
+        # required sys_clk = line_rate / bus.data_width; line_rate = sata_clk_freq * 16
+        # (sata_clk_freqs entries are 16-bit phy clocks). At bus.data_width=32 this is
+        # sata_clk_freq/2, matching the prior hardcoded check.
         sata_clk_freqs = {
             "gen1":  75e6,
             "gen2": 150e6,
             "gen3": 300e6,
         }
-        sata_clk_freq = sata_clk_freqs[phy.gen]
-        # FIXME: /2 for 16-bit data-width, add support for 32-bit.
-        if self.clk_freq < sata_clk_freq/2:
-            self.logger.error("SATA requires sys_clk_freq ({:.1f}MHz) >= {}/2 ({:.1f}MHz).".format(
-                self.clk_freq/1e6, phy.gen, sata_clk_freq/2/1e6))
+        sata_clk_freq    = sata_clk_freqs[phy.gen]
+        required_sys_clk = sata_clk_freq * 16 / self.bus.data_width
+        if self.clk_freq < required_sys_clk:
+            self.logger.error("SATA {} requires sys_clk_freq ({:.1f}MHz) >= {:.1f}MHz on a {}-bit bus.".format(
+                colorer(phy.gen, color="red"), self.clk_freq/1e6, required_sys_clk/1e6,
+                self.bus.data_width))
             raise SoCError()
 
         # Core.
