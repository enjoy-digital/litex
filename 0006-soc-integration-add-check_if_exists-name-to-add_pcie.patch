From 498e1d66255d866d9250bb951c3356faf244b535 Mon Sep 17 00:00:00 2001
From: Florent Kermarrec <florent@enjoy-digital.fr>
Date: Mon, 27 Apr 2026 09:46:49 +0000
Subject: [PATCH 06/22] soc/integration: add check_if_exists(name) to add_pcie

Every other peripheral add_* method starts with
self.check_if_exists(name) so that double-adding a peripheral
fails fast and loudly. add_pcie checked the four sub-modules
it creates (`{name}_endpoint`, `{name}_mmap`, msi_name, the
DMAs) but never the top-level `name` itself. Calling
add_pcie(name="foo") twice would silently overwrite some
attributes and then fail confusingly downstream.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 litex/soc/integration/soc.py | 1 +
 1 file changed, 1 insertion(+)

diff --git a/litex/soc/integration/soc.py b/litex/soc/integration/soc.py
index eb4e69a8d..2b63ed6c7 100644
--- a/litex/soc/integration/soc.py
+++ b/litex/soc/integration/soc.py
@@ -2556,6 +2556,7 @@ class LiteXSoC(SoC):
         from litepcie.frontend.wishbone import LitePCIeWishboneMaster
 
         # Checks.
+        self.check_if_exists(name)
         assert self.csr.data_width == 32
 
         # PCIe submodule naming (allows projects to keep legacy CSR names for DMA/MSI).
-- 
