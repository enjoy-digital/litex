From 4504379afa5fd904ae068cfc5fb5d3c52a45c77e Mon Sep 17 00:00:00 2001
From: Florent Kermarrec <florent@enjoy-digital.fr>
Date: Tue, 21 Apr 2026 18:39:25 +0000
Subject: [PATCH] ci/test_integration: run pytest in parallel with pytest-xdist
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Tests dominate CI runtime (~20min out of ~27min), driven by 31 boot
sims in test_integration (test_cpu + test_buses). They are independent
processes, so run them in parallel:

- .github/workflows/ci.yml: install pytest-xdist and run `pytest -n auto`.
- test/test_integration.py: give each test its own --output-dir via the
  tmp_path fixture (default ./build/sim would otherwise be shared and
  clobbered between workers), and scale the --jobs passed to litex_sim
  by PYTEST_XDIST_WORKER_COUNT so N workers × M gcc jobs doesn't
  oversubscribe the runner.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 .github/workflows/ci.yml |  4 ++--
 test/test_integration.py | 22 ++++++++++++++++------
 2 files changed, 18 insertions(+), 8 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 5fc263df7..03705983b 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -29,7 +29,7 @@ jobs:
 
       - name: Install Python dependencies
         run: |
-          python3 -m pip install setuptools requests pexpect meson pytest
+          python3 -m pip install setuptools requests pexpect meson pytest pytest-xdist
 
       # Install (n)Migen / LiteX / Cores
       - name: Install LiteX
@@ -80,4 +80,4 @@ jobs:
       # Test
       - name: Run Tests
         run: |
-          python3 -m pytest -v
+          python3 -m pytest -v -n auto
diff --git a/test/test_integration.py b/test/test_integration.py
index 499bc94ab..c97dfd5f8 100644
--- a/test/test_integration.py
+++ b/test/test_integration.py
@@ -12,8 +12,18 @@ import tempfile
 import itertools
 import pytest
 
-def boot_test(cpu_type="vexriscv", cpu_variant="standard", args=""):
-    cmd = f'litex_sim --cpu-type={cpu_type} --cpu-variant={cpu_variant} {args} --opt-level=O0 --jobs {os.cpu_count()}'
+def _sim_jobs():
+    # When pytest-xdist is running several tests in parallel, divide the
+    # available cores between workers to avoid oversubscribing the build.
+    workers = int(os.environ.get("PYTEST_XDIST_WORKER_COUNT", "1") or "1")
+    return max(1, (os.cpu_count() or 1) // max(1, workers))
+
+def boot_test(cpu_type="vexriscv", cpu_variant="standard", args="", output_dir=None):
+    output_arg = f' --output-dir={output_dir}' if output_dir else ''
+    cmd = (
+        f'litex_sim --cpu-type={cpu_type} --cpu-variant={cpu_variant} {args}'
+        f'{output_arg} --opt-level=O0 --jobs {_sim_jobs()}'
+    )
     litex_prompt = [r'\033\[[0-9;]+mlitex\033\[[0-9;]+m>']
     is_success = True
 
@@ -76,8 +86,8 @@ UNTESTED_CPUS = [
 ]
 
 @pytest.mark.parametrize("cpu", TESTED_CPUS)
-def test_cpu(cpu, request):
-    assert boot_test(cpu_type=cpu)
+def test_cpu(cpu, request, tmp_path):
+    assert boot_test(cpu_type=cpu, output_dir=str(tmp_path))
 
 BUS_OPTIONS = [
     ("--bus-standard", ["wishbone", "axi-lite", "axi"]),
@@ -127,5 +137,5 @@ def _build_bus_cases():
 BUS_CASES = _build_bus_cases()
 
 @pytest.mark.parametrize("args", BUS_CASES)
-def test_buses(args, request):
-    assert boot_test(args=args)
+def test_buses(args, request, tmp_path):
+    assert boot_test(args=args, output_dir=str(tmp_path))
-- 
