+            with open(filename, "w") as f:
+                json.dump([
+                    {
+                        "directory" : src_dir,
+                        "file"      : "../../libbase/console.c",
+                        "command"   : "riscv64-unknown-elf-gcc -c ../../libbase/console.c",
+                    },
+                    {
+                        "directory" : src_dir,
+                        "file"      : "../../libbase/console.c",
+                        "command"   : "riscv64-unknown-elf-gcc -c ../../libbase/console.c",
+                    },
+                    {
+                        "directory" : src_dir,
+                        "file"      : "/src/crt0.S",
+                        "arguments" : ["riscv64-unknown-elf-gcc", "-c", "/src/crt0.S"],
+                    },
+                    {
+                        "directory" : src_dir,
+                        "file"      : "/src/link.elf",
+                    },
