+    def _check_bear(self):
+        bear = shutil.which("bear")
+        if bear is None:
+            msg = "Unable to find Bear compile command generator, please install it with:\n"
+            msg += "- apt install bear (or your OS equivalent).\n"
+            msg += "Or disable --software-compile-commands.\n"
+            raise OSError(msg)
+        return bear
+
+    def _post_process_software_compile_commands(self, filename):
+        if os.path.exists(filename):
+            with open(filename) as f:
+                try:
+                    compile_commands = json.load(f)
+                except json.JSONDecodeError:
+                    compile_commands = []
+        else:
+            compile_commands = []
+
+        processed_compile_commands = []
+        seen = set()
+        for entry in compile_commands:
+            directory       = entry.get("directory")
+            source_filename = entry.get("file")
+            if directory is None or source_filename is None:
+                continue
+            if "command" not in entry and "arguments" not in entry:
+                continue
+
+            entry           = dict(entry)
+            directory       = os.path.realpath(directory)
+            if not os.path.isabs(source_filename):
+                source_filename = os.path.realpath(os.path.join(directory, source_filename))
+
+            entry["directory"] = directory
+            entry["file"]      = source_filename
+
+            command = entry.get("command")
+            if command is None:
+                command = tuple(entry.get("arguments", []))
+            key = (entry["directory"], entry["file"], entry.get("output"), command)
+            if key in seen:
+                continue
+            seen.add(key)
+            processed_compile_commands.append(entry)
+
+        self._export_write(
+            filename,
+            json.dumps(processed_compile_commands, indent=4) + "\n",
+        )
+
     def _generate_rom_software(self, compile_bios=True):
+        compile_commands_filename = self.get_software_compile_commands_filename()
+        if compile_commands_filename is not None:
+            if not self.compile_software:
+                raise OSError("--software-compile-commands requires software compilation.")
+            bear = self._check_bear()
+            compile_commands_filename = os.path.realpath(compile_commands_filename)
+            os.makedirs(os.path.dirname(compile_commands_filename), exist_ok=True)
+            if os.path.exists(compile_commands_filename):
+                os.remove(compile_commands_filename)
+        else:
+            bear = None
+
         # Compile all software packages.
         cpu_count = os.cpu_count() or 1
+        append_compile_commands = False
         for name, src_dir in self.software_packages:
             # Skip BIOS compilation when disabled.
             if name == "bios" and not compile_bios:
@@ -394,7 +461,30 @@ class Builder:
             dst_dir  = os.path.join(self.software_dir, name)
             makefile = os.path.join(src_dir, "Makefile")
             if self.compile_software:
-                subprocess.check_call(["make", f"-j{cpu_count}", "-C", dst_dir, "-f", makefile])
+                make_command = ["make", f"-j{cpu_count}"]
+                if compile_commands_filename is not None:
+                    make_command += ["--always-make"]
+                make_command += ["-C", dst_dir, "-f", makefile]
+
+                if compile_commands_filename is None:
+                    subprocess.check_call(make_command)
+                else:
+                    bear_command = [bear, "--output", compile_commands_filename]
+                    if append_compile_commands:
+                        bear_command += ["--append"]
+                    bear_command += make_command
+                    subprocess.check_call(bear_command)
+                    append_compile_commands = True
+
+        if compile_commands_filename is not None:
+            self._post_process_software_compile_commands(compile_commands_filename)
+
+    def get_software_compile_commands_filename(self):
+        if not self.software_compile_commands:
+            return None
+        if isinstance(self.software_compile_commands, str):
+            return os.path.abspath(self.software_compile_commands)
+        return os.path.join(self.output_dir, "compile_commands.json")
 
