+    def test_generate_rom_software_uses_bear_for_compile_commands(self):
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            builder = object.__new__(Builder)
+            builder.output_dir                 = tmp_dir
+            builder.software_dir               = os.path.join(tmp_dir, "software")
+            builder.compile_software           = True
+            builder.software_compile_commands  = True
+            builder.software_packages          = [
+                ("libbase", os.path.join(tmp_dir, "libbase_src")),
+                ("bios",    os.path.join(tmp_dir, "bios_src")),
+            ]
+
+            with patch("litex.soc.integration.builder.shutil.which", return_value="/usr/bin/bear"):
