${CVA6_REPO_DIR}/vendor/pulp-platform/axi/src/axi_xbar.sv

// AXI RISC-V atomics adapter
${CVA6_REPO_DIR}/vendor/pulp-platform/axi_riscv_atomics/src/axi_res_tbl.sv
${CVA6_REPO_DIR}/vendor/pulp-platform/axi_riscv_atomics/src/axi_riscv_amos_alu.sv
