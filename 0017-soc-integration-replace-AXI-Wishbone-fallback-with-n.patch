From 85292029756ec723c46fcce00fc17f9791ecc027 Mon Sep 17 00:00:00 2001
From: Florent Kermarrec <florent@enjoy-digital.fr>
Date: Mon, 27 Apr 2026 10:55:41 +0000
Subject: [PATCH 17/22] soc/integration: replace AXI->Wishbone fallback with
 native AXIDownConverter

soc.py:add_sdram had a long-standing FIXME on the path that
connects a CPU's direct AXI memory bus to LiteDRAM when the CPU
side is *wider* than the LiteDRAM port. The code was routing
through a Wishbone bridge:

  cpu.mem_axi
    -> AXI2Wishbone   (mem_bus.data_width)
    -> wishbone.Converter (... -> port.data_width)
    -> LiteDRAMWishbone2Native

That's three modules in series on a memory-critical path, and
loses AXI semantics (id propagation, response codes, burst types)
along the way. AXIDownConverter has been available in
litex.soc.interconnect.axi.axi_full for a while and does the
data-width reduction natively in AXI; the FIXME just never got
back-ported to add_sdram.

Replace the fallback with the obvious mirror of the up-convert
path:

  cpu.mem_axi
    -> AXIDownConverter
    -> LiteDRAMAXI2Native

Add a focused unit test (test_axi_down_converter_burst) that
exercises this exact composition: a wide-side AXI master writes
and reads INCR bursts of length {1, 2, 4, 8, 16} through an
AXIDownConverter into an AXISRAM at the narrow side, with passive
observers on the narrow W and R channels checking that each
wide-side `length`-beat burst expands to exactly `length * ratio`
narrow-side data beats. Verified across four width pairs: 64->32,
128->32, 128->64, 64->16.

(The existing test_axi_down_converter is a single-beat smoke test
through an AXI->Wishbone path; the new one drives bursts and
keeps everything in AXI, matching the SoC's now-direct flow.)

All in-tree tests stay green: test_axi.py / test_axi_lite.py /
test_wishbone.py = 70 + 29 subtests. digilent_arty builds
byte-identical (path isn't exercised by VexRiscv's
Wishbone-only mem_bus, but the build remains clean).

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 litex/soc/integration/soc.py | 27 ++++++-------
 test/test_axi.py             | 76 ++++++++++++++++++++++++++++++++++++
 2 files changed, 88 insertions(+), 15 deletions(-)

diff --git a/litex/soc/integration/soc.py b/litex/soc/integration/soc.py
index 869bbb02e..f2d4319f9 100644
--- a/litex/soc/integration/soc.py
+++ b/litex/soc/integration/soc.py
@@ -1870,24 +1870,21 @@ class LiteXSoC(SoC):
                             port         = port,
                             base_address = self.bus.regions["main_ram"].origin
                         )
-                    # DownConvert. FIXME: Pass through Wishbone for now, create/use native AXI converter.
+                    # DownConvert.
                     else:
-                        mem_wb  = wishbone.Interface(
-                            data_width = self.cpu.mem_axi.data_width,
-                            adr_width  = 32-log2_int(mem_bus.data_width//8),
-                            addressing = "word",
+                        axi_port = axi.AXIInterface(
+                            data_width = port.data_width,
+                            id_width   = len(mem_bus.aw.id),
                         )
-                        mem_a2w = axi.AXI2Wishbone(
-                            axi          = mem_bus,
-                            wishbone     = mem_wb,
-                            base_address = 0)
-                        self.submodules += mem_a2w
-                        litedram_wb = wishbone.Interface(port.data_width)
-                        self.submodules += LiteDRAMWishbone2Native(
-                            wishbone     = litedram_wb,
+                        self.submodules += axi.AXIDownConverter(
+                            axi_from = mem_bus,
+                            axi_to   = axi_port,
+                        )
+                        self.submodules += LiteDRAMAXI2Native(
+                            axi          = axi_port,
                             port         = port,
-                            base_address = self.bus.regions["main_ram"].origin)
-                        self.submodules += wishbone.Converter(mem_wb, litedram_wb)
+                            base_address = self.bus.regions["main_ram"].origin
+                        )
 
                 # Check if bus is a Native bus and connect it.
                 if isinstance(mem_bus, LiteDRAMNativePort):
diff --git a/test/test_axi.py b/test/test_axi.py
index f3fd624d2..216b201f8 100644
--- a/test/test_axi.py
+++ b/test/test_axi.py
@@ -616,6 +616,82 @@ class TestAXI(unittest.TestCase):
         dut = DUT(64, 32)
         run_simulation(dut, [read_generator(dut), write_generator(dut)], vcd_name="sim.vcd")
 
+    def test_axi_down_converter_burst(self):
+        # Exercises AXIDownConverter (now also used by SoC.add_sdram for the
+        # CPU.mem_axi.data_width > LiteDRAM.port.data_width case) on real bursts:
+        # a wide-side AXI master writes/reads bursts of various lengths and types,
+        # the converter forwards them onto a narrower AXI bus, and an AXISRAM at
+        # the narrow side serves the actual storage. We check both that the
+        # bridge generates the right narrow-side request count (each wide beat
+        # turns into `ratio` narrow beats), and that the data round-trips correctly.
+
+        class DUT(LiteXModule):
+            def __init__(self, dw_wide=64, dw_narrow=32, mem_bytes=4096):
+                self.axi_wide   = AXIInterface(data_width=dw_wide,   address_width=32, id_width=4)
+                self.axi_narrow = AXIInterface(data_width=dw_narrow, address_width=32, id_width=4)
+                self.converter  = AXIDownConverter(self.axi_wide, self.axi_narrow)
+                self.sram       = AXISRAM(mem_bytes, bus=self.axi_narrow, init=[0]*(mem_bytes//(dw_narrow//8)))
+                self.errors     = 0
+
+        @passive
+        def narrow_w_beats(axi_narrow, counter):
+            while True:
+                if (yield axi_narrow.w.valid) and (yield axi_narrow.w.ready):
+                    counter[0] += 1
+                yield
+
+        @passive
+        def narrow_r_beats(axi_narrow, counter):
+            while True:
+                if (yield axi_narrow.r.valid) and (yield axi_narrow.r.ready):
+                    counter[0] += 1
+                yield
+
+        def gen(dut, dw_wide, dw_narrow, w_counter, r_counter):
+            prng        = random.Random(0xd06e)
+            ratio       = dw_wide // dw_narrow
+            wide_size   = log2_int(dw_wide  // 8)  # bytes-per-beat encoded as log2.
+            wide_bytes  = dw_wide // 8
+
+            # Sweep INCR burst lengths.  After each wide-side burst of `length` beats we expect
+            # exactly `length * ratio` narrow-side data beats (the converter issues one narrow
+            # AW/AR per wide burst with len*ratio extension; the multiplication shows up on the
+            # W and R channels). Combined with the data round-trip check this verifies both the
+            # length expansion and the data ordering through the StrideConverters.
+            for length in [1, 2, 4, 8, 16]:
+                base    = (length * wide_bytes * 8)            # spaced base address per length
+                beats   = [prng.randrange(2**dw_wide) for _ in range(length)]
+
+                w_before = w_counter[0]
+                resp = yield from axi_write_burst(dut.axi_wide, base, beats, size=wide_size)
+                if resp != RESP_OKAY:
+                    dut.errors += 1
+                for _ in range(16):
+                    yield
+                if w_counter[0] - w_before != length * ratio:
+                    dut.errors += 1
+
+                r_before = r_counter[0]
+                read = yield from axi_read_burst(dut.axi_wide, base, length, size=wide_size)
+                for _ in range(16):
+                    yield
+                if r_counter[0] - r_before != length * ratio:
+                    dut.errors += 1
+                if read != beats:
+                    dut.errors += 1
+
+        for dw_wide, dw_narrow in [(64, 32), (128, 32), (128, 64), (64, 16)]:
+            with self.subTest(dw_wide=dw_wide, dw_narrow=dw_narrow):
+                dut = DUT(dw_wide=dw_wide, dw_narrow=dw_narrow, mem_bytes=4096)
+                w_counter = [0]
+                r_counter = [0]
+                run_simulation(dut, [
+                    gen(dut, dw_wide, dw_narrow, w_counter, r_counter),
+                    narrow_w_beats(dut.axi_narrow, w_counter),
+                    narrow_r_beats(dut.axi_narrow, r_counter),
+                ])
+                self.assertEqual(dut.errors, 0)
+
     # AXISRAM helper: builds a DUT with a 32-bit AXI bus and runs the supplied generator.
     def _axisram_run(self, generator, size=64*4, init=None, data_width=32):
         class DUT(LiteXModule):
