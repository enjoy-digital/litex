+                ).Else(
+                    NextValue(aw_emit_count, aw_emit_count + 1),
+                    NextState("FIXED-EMIT-AW"),
+                )
+            )
+        )
+        aw_fsm.act("FIXED-EMIT-B",
+            fixed_aw_active.eq(1),
+            axi_from.b.valid.eq(1),
+            axi_from.b.id.eq(cap_aw_id),
+            axi_from.b.resp.eq(b_collected_resp),
+            If(axi_from.b.ready,
+                NextState("IDLE"),
+            )
+        )
 
