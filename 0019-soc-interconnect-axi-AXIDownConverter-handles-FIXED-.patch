+        cap_aw_size   = Signal.like(axi_from.aw.size)
+        cap_aw_id     = Signal.like(axi_from.aw.id)
+        cap_aw_lock   = Signal.like(axi_from.aw.lock)
+        cap_aw_prot   = Signal.like(axi_from.aw.prot)
