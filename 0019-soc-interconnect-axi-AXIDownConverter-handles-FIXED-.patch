+        aw_fsm.act("IDLE",
+            If(~is_aw_fixed,
+                # Fast path: combinational forward with len/size/burst conversion.
+                axi_to.aw.valid.eq(axi_from.aw.valid),
+                axi_to.aw.addr.eq(axi_from.aw.addr),
