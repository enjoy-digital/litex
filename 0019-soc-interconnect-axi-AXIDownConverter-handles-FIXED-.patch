+                    BURST_INCR:     axi_to.aw.burst.eq(BURST_INCR),
+                    BURST_WRAP:     axi_to.aw.burst.eq(BURST_WRAP),
+                    BURST_RESERVED: axi_to.aw.burst.eq(BURST_RESERVED),
