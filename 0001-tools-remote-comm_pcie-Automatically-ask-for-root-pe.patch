From ea0d537338f7990c6d9849cb0cffa1fe41c4ad30 Mon Sep 17 00:00:00 2001
From: Florent Kermarrec <florent@enjoy-digital.fr>
Date: Wed, 8 Oct 2025 10:53:37 +0200
Subject: [PATCH 1/3] tools/remote/comm_pcie: Automatically ask for root
 permission if not already available.

---
 litex/tools/remote/comm_pcie.py | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/litex/tools/remote/comm_pcie.py b/litex/tools/remote/comm_pcie.py
index dfe7eae36..42238eee7 100644
--- a/litex/tools/remote/comm_pcie.py
+++ b/litex/tools/remote/comm_pcie.py
@@ -5,8 +5,9 @@
 # SPDX-License-Identifier: BSD-2-Clause
 
 import os
-import ctypes
 import mmap
+import ctypes
+import subprocess
 
 from litex.tools.remote.csr_builder import CSRBuilder
 
@@ -17,14 +18,23 @@ class CommPCIe(CSRBuilder):
         CSRBuilder.__init__(self, comm=self, csr_csv=csr_csv)
         if "/sys/bus/pci/devices" not in bar:
             bar = f"/sys/bus/pci/devices/0000:{bar}/resource0"
-        self.bar   = bar
-        self.debug = debug
+        self.bar         = bar
+        self.enable_path = self.bar.replace("resource0", "enable")
+        self.debug       = debug
+        self._make_accessible(self.enable_path)
+        self._make_accessible(self.bar)
 
         self.enable()
 
+    def _make_accessible(self, path):
+        cmd = ["chmod", "666", path]
+        if os.geteuid() != 0:
+            cmd = ["sudo"] + cmd
+        subprocess.check_call(cmd, stderr=subprocess.DEVNULL)
+
     def enable(self):
         # Enable PCIe device is not already enabled.
-        enable = open(self.bar.replace("resource0", "enable"), "r+")
+        enable = open(self.enable_path, "r+")
         if enable.read(1) == "0":
             enable.seek(0)
             enable.write("1")
-- 
